#Penjelasan Konfigurasi path file, folder output, parameter model, dan pemetaan label grafik
BASE_DIR = Path(__file__).resolve().parent
FILE_PATH = BASE_DIR / "stadat-ipa0037-13.2.1.7-en.xlsx"
OUTPUT_DIR = BASE_DIR / "hasil_analisis"
OUTPUT_DIR.mkdir(exist_ok=True)

CORRELATION_THRESHOLD = 0.40
REFERENCE_FEATURE = "Industry (excluding water and waste management) B+C+D"
EXCLUDED_AGGREGATES = {"Manufacturing C", REFERENCE_FEATURE}
SELECTED_K = 3
K_RANGE = range(2, 7)
RANDOM_STATE = 42

LABEL_MAP = {
    "Mining and quarrying B": "Mining (B)",
    "Manufacture of food products, beverages and tobacco products CA": "Food & Tobacco (CA)",
    "Manufacture of textiles, apparel, leather and related products CB": "Textiles & Leather (CB)",
    "Manufacture of wood and paper products, and printing CC": "Wood & Paper (CC)",
    "Manufacture of coke, and refined petroleum products CD": "Coke & Petroleum (CD)",
