import polars as pl
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, accuracy_score

# ==============================================================================
# TAHAP 4: DATA SPLITTING (TRAINING 70%, VALIDATION 15%, TESTING 15%)
# ==============================================================================
print("=== [1/3] DATA SPLITTING (TRAIN 70%, VALIDATION 15%, TESTING 15%) ===")

# Matriks Fitur (X_scaled) dan Target Variable (Cluster_Label)
X = X_scaled
y = df_polars["Cluster_Label"].to_numpy()

# 1. Split Pertama: Memisahkan 15% untuk Test Set (Data Uji Akhir)
X_train_val, X_test, y_train_val, y_test = train_test_split(
    X, y, test_size=0.15, random_state=42, stratify=y
)

# 2. Split Kedua: Membagi Sisa Data (85%) Menjadi Training (70%) dan Validation (15%)
X_train, X_val, y_train, y_val = train_test_split(
    X_train_val, y_train_val, test_size=0.176, random_state=42, stratify=y_train_val
)

print(f"Hasil Pembagian Subset Data (Stratified Split):")
print(f"- Training Set (70%)   : {len(X_train)} Sampel Bulan")
print(f"- Validation Set (15%) : {len(X_val)} Sampel Bulan")
print(f"- Testing Set (15%)    : {len(X_test)} Sampel Bulan\n")


# ==============================================================================
# TAHAP 5: PELATIHAN MACHINE LEARNING (RANDOM FOREST CLASSIFIER) & EVALUASI
# ==============================================================================
print("=== [2/3] PELATIHAN MACHINE LEARNING (RANDOM FOREST CLASSIFIER) ===")

# 1. Inisialisasi & Fitting Model Random Forest pada Data Training
rf_model = RandomForestClassifier(n_estimators=100, random_state=42)
rf_model.fit(X_train, y_train)

# 2. Pengujian Model pada Validation Set
val_preds = rf_model.predict(X_val)
val_acc = accuracy_score(y_val, val_preds)

print(f"--- EVALUASI VALIDATION SET ---")
print(f"Akurasi Validation Set : {val_acc * 100:.2f}%")
print("[ Classification Report Validation Set ]")
print(classification_report(y_val, val_preds))

# 3. Pengujian Akhir Model pada Test Set
test_preds = rf_model.predict(X_test)
test_acc = accuracy_score(y_test, test_preds)

print(f"--- EVALUASI TESTING SET ---")
print(f"Akurasi Test Set       : {test_acc * 100:.2f}%")
print("[ Classification Report Test Set ]")
print(classification_report(y_test, test_preds))


